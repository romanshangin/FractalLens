      "action": "REUSE",
      "role": "control",
      "max_ratio": 1.05
    },
    {
      "metric": "first_visible_publish_ms",
      "role": "control",
      "max_ratio": 1.05
    },
    {
      "metric": "full_publish_ms",
      "role": "control",
      "max_ratio": 1.05
    },
    {
      "metric": "first_post_layout_ms",
      "role": "control",
      "max_ratio": 1.05
    },
    {
      "metric": "full_post_layout_ms",
      "role": "control",
      "max_ratio": 1.05
    },
    {
      "metric": "first_aa_tile_ms",
      "fixture": "mandelbrot-aa-regular",
      "role": "control",
      "max_ratio": 1.05
    }
  ]
}
