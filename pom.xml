<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.shangin</groupId>
    <artifactId>fractal-ui</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <javafx.version>26.0.2</javafx.version>
        <junit.version>6.1.3</junit.version>
        <lwjgl.version>3.4.2</lwjgl.version>
        <lwjgl.macos.natives>natives-macos</lwjgl.macos.natives>
        <fractal.mainClass>com.shangin.fractal/com.shangin.fractal.app.FractalApplication</fractal.mainClass>

        <maven.compiler.version>3.15.0</maven.compiler.version>
        <maven.surefire.version>3.5.5</maven.surefire.version>
        <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
    </properties>

    <dependencies>
        <!-- Java bindings are portable; native libraries are platform-specific. -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <version>${lwjgl.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-vulkan</artifactId>
            <version>${lwjgl.version}</version>
        </dependency>
        <!-- GLSL to SPIR-V compiler, loaded lazily by the optional palette kernel. -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-shaderc</artifactId>
            <version>${lwjgl.version}</version>
        </dependency>
        <!-- UI and 2D rendering -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Unit tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
                <configuration>
                    <argLine>--enable-native-access=org.lwjgl --add-modules=ALL-MODULE-PATH --sun-misc-unsafe-memory-access=deny</argLine>
                    <systemPropertyVariables>
                        <fractal.gpu.enabled>false</fractal.gpu.enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.maven.plugin.version}</version>
                <configuration>
                    <mainClass>${fractal.mainClass}</mainClass>

                    <options>
                        <option>--enable-native-access=javafx.graphics,org.lwjgl</option>
                        <option>--add-modules=ALL-MODULE-PATH</option>
                    </options>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <profile>
            <id>fp32-native</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes><include>**/MandelbrotPrecisionNativeTest.java</include></includes>
                    <systemPropertyVariables>
                        <fractal.gpu.fp32Native>true</fractal.gpu.fp32Native>
                    </systemPropertyVariables>
                </configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>fp32-precision</id>
            <build><plugins><plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions><execution>
                    <id>mandelbrot-fp32-precision</id>
                    <phase>integration-test</phase>
                    <goals><goal>java</goal></goals>
                    <configuration>
                        <mainClass>com.shangin.fractal.render.MandelbrotFloatPrecisionBenchmark</mainClass>
                        <classpathScope>test</classpathScope>
                    </configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>macos-app-name</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <configuration>
                            <options combine.children="append">
                                <option>-Xdock:name=FractalUI</option>
                                <!-- Set before JavaFX starts so the generic Java icon never appears. -->
                                <option>-Xdock:icon=${project.basedir}/src/main/resources/com/shangin/fractal/app/icons/FractalUI.icns</option>
                                <option>--add-exports=javafx.graphics/com.sun.glass.ui=com.shangin.fractal</option>
                                <option>--add-opens=javafx.graphics/com.sun.glass.ui.mac=com.shangin.fractal</option>
                            </options>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>palette-benchmark</id>
            <properties>
                <fractal.mainClass>com.shangin.fractal/com.shangin.fractal.ui.PaletteRecolorBenchmark</fractal.mainClass>
            </properties>
        </profile>
        <profile>
            <id>gpu-render-benchmark</id>
            <properties>
                <fractal.mainClass>com.shangin.fractal/com.shangin.fractal.ui.GpuRenderBenchmark</fractal.mainClass>
            </properties>
        </profile>
        <!-- MoltenVK is bundled in lwjgl-vulkan's macOS native artifact. -->
        <profile>
            <id>gpu-macos</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl</artifactId>
                    <version>${lwjgl.version}</version>
                    <classifier>${lwjgl.macos.natives}</classifier>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl-vulkan</artifactId>
                    <version>${lwjgl.version}</version>
                    <classifier>${lwjgl.macos.natives}</classifier>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl-shaderc</artifactId>
                    <version>${lwjgl.version}</version>
                    <classifier>${lwjgl.macos.natives}</classifier>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>macos-aarch64</id>
            <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
            <properties><lwjgl.macos.natives>natives-macos-arm64</lwjgl.macos.natives></properties>
        </profile>
        <profile>
            <id>macos-arm64</id>
            <activation><os><family>mac</family><arch>arm64</arch></os></activation>
            <properties><lwjgl.macos.natives>natives-macos-arm64</lwjgl.macos.natives></properties>
        </profile>
        <profile>
            <id>gpu-smoke</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/GpuRuntimeNativeTest.java</include>
                        <include>**/PaletteRecolorNativeTest.java</include>
                        <include>**/GpuMandelbrotRenderBackendNativeTest.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <fractal.gpu.enabled>true</fractal.gpu.enabled>
                        <fractal.gpu.nativeSmoke>true</fractal.gpu.nativeSmoke>
                    </systemPropertyVariables>
                </configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>gpu-diagnostics</id>
            <properties>
                <fractal.mainClass>com.shangin.fractal/com.shangin.fractal.gpu.GpuRuntimeDiagnostics</fractal.mainClass>
            </properties>
        </profile>
        <profile>
            <id>benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>frame-reuse-benchmark</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>com.shangin.fractal.render.FrameReuseBenchmark</mainClass>
                                    <classpathScope>test</classpathScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>formula-benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>formula-calculation-benchmark</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>com.shangin.fractal.render.FormulaCalculationBenchmark</mainClass>
                                    <classpathScope>test</classpathScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>symmetry-benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>mandelbrot-symmetry-benchmark</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>com.shangin.fractal.render.MandelbrotSymmetryBenchmark</mainClass>
                                    <classpathScope>test</classpathScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>render-tuning-benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>render-tuning-benchmark</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>com.shangin.fractal.render.RenderTuningBenchmark</mainClass>
                                    <classpathScope>test</classpathScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>julia-pipeline-benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>julia-pipeline-benchmark</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>com.shangin.fractal.render.JuliaPipelineBenchmark</mainClass>
                                    <classpathScope>test</classpathScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>perturbation-benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>perturbation-benchmark</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>com.shangin.fractal.render.PerturbationBenchmark</mainClass>
                                    <classpathScope>test</classpathScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>series-approximation-benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>series-approximation-benchmark</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>com.shangin.fractal.render.SeriesApproximationBenchmark</mainClass>
                                    <classpathScope>test</classpathScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>distance-estimation-benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>distance-estimation-benchmark</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>com.shangin.fractal.render.DistanceEstimationBenchmark</mainClass>
                                    <classpathScope>test</classpathScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
