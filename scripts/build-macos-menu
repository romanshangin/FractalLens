#!/bin/bash
set -euo pipefail
project_dir=$(cd "$(dirname "$0")/.." && pwd)
java_home=$1
output_dir=$2
mkdir -p "$output_dir/com/shangin/fractal/ui/native"
xcrun --sdk macosx clang -dynamiclib -fobjc-arc -Wall -Wextra -Werror \
    -arch arm64 -arch x86_64 \
    -mmacosx-version-min=11.0 -I"$java_home/include" -I"$java_home/include/darwin" \
    -framework Cocoa "$project_dir/src/main/macos/FractalContextMenu.m" \
    -o "$output_dir/com/shangin/fractal/ui/native/libfractal-menu.dylib"
