#!/usr/bin/env bash

set -eu

readonly expected_exit=37
readonly console_limit=8000
readonly status_line='Running test command; output is buffered and retained in target/ci-test.log.'
console_log="$(mktemp "${TMPDIR:-/tmp}/fractalui-ci-console.XXXXXX")"
trap 'rm -f "$console_log"' EXIT

set +e
bash scripts/run-ci-tests bash -c \
    'printf "probe-start\n"; for ((i = 0; i < 12000; i++)); do printf z; done; printf "\nprobe-end\n"; exit 37' \
    >"$console_log"
actual_exit=$?
set -e

if [[ $actual_exit -ne $expected_exit ]]; then
    printf 'Expected exit code %d, got %d\n' "$expected_exit" "$actual_exit" >&2
    exit 1
fi

console_size="$(wc -c <"$console_log" | tr -d ' ')"
if [[ $console_size -gt $console_limit ]]; then
    printf 'Console output exceeded limit: %d > %d bytes\n' "$console_size" "$console_limit" >&2
    exit 1
fi

full_log=target/ci-test.log
test -f "$full_log"
grep -q '^probe-start$' "$full_log"
grep -q '^probe-end$' "$full_log"
grep -q '^probe-start$' "$console_log"
grep -q '^probe-end$' "$console_log"

marker="$(grep -E '^\.\.\. \[[0-9]+ bytes omitted; full output: target/ci-test\.log\] \.\.\.$' "$console_log")"
reported_omitted="$(printf '%s\n' "$marker" | sed -E 's/^\.\.\. \[([0-9]+) bytes omitted;.*/\1/')"
full_size="$(wc -c <"$full_log" | tr -d ' ')"
status_size=$((${#status_line} + 1))
marker_size=$((${#marker} + 2))
displayed_log_size=$((console_size - status_size - marker_size))
actual_omitted=$((full_size - displayed_log_size))

if [[ $reported_omitted -ne $actual_omitted ]]; then
    printf 'Reported omission %d does not match actual omission %d\n' \
        "$reported_omitted" "$actual_omitted" >&2
    exit 1
fi

printf 'Bash CI wrapper contract passed: exit=%d console=%d full=%d omitted=%d\n' \
    "$actual_exit" "$console_size" "$full_size" "$actual_omitted"
